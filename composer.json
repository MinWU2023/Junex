{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "ext-json": "*",
        "astrotomic/laravel-translatable": "^11.9",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "fzaninotto/faker": "^1.9",
        "geoip2/geoip2": "^2.11",
        "google/apiclient": "^2.11",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.5",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^8.5",
        "laravel/horizon": "^5.4",
        "laravel/jetstream": "^1.5",
        "laravel/sanctum": "^2.6",
        "laravel/tinker": "^2.0",
        "livewire/livewire": "^2.0",
        "lustre/php-dfa-sensitive": "^1.4",
        "mews/captcha": "^3.2",
        "nahid/talk": "^2.4",
        "nelexa/zip": "^4.0",
        "nesbot/carbon": "^2.72.0",
        "overtrue/laravel-ueditor": "^1.2",
        "php-imap/php-imap": "^2.0",
        "predis/predis": "^1.1",
        "spatie/db-dumper": "^2.21",
        "spatie/laravel-honeypot": "^3.0",
        "spatie/laravel-permission": "^3.18",
        "stechstudio/laravel-zipstream": "^4.5",
        "symfony/translation": "^5.4",
        "webklex/laravel-imap": "^2.4",
        "yohang88/letter-avatar": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "facade/ignition": "^2.3.6",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "ext-pcntl": "7.2",
            "ext-posix": "7.2"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Addons\\": "addons/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Illuminate\\Support\\": "overrides/laravel/framework/src/Illuminate/Support/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
