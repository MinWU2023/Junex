{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{SITE_URL}}/#website",
      "url": "{{SITE_URL}}/",
      "name": "{{SITE_NAME}}",
      "description": "{{SITE_DESCRIPTION}}",
      "inLanguage": "{{LOCALE}}",
      "publisher": {
        "@id": "{{SITE_URL}}/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{SEARCH_URL}}{search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "{{SITE_URL}}/#organization",
      "name": "{{SITE_NAME}}",
      "url": "{{SITE_URL}}/",
      "description": "{{SITE_DESCRIPTION}}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{LOGO_URL}}"
      },
      "email": "{{ORG_EMAIL}}",
      "telephone": "{{ORG_PHONE}}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ORG_ADDRESS}}"
      },
      "sameAs": "{{SAME_AS}}"
    }
  ]
}
