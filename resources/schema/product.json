{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": "{{PAGE_URL}}#product",
      "url": "{{PAGE_URL}}",
      "name": "{{PRODUCT_NAME}}",
      "description": "{{PAGE_DESCRIPTION}}",
      "image": "{{PRODUCT_IMAGE}}",
      "sku": "{{PRODUCT_SKU}}",
      "category": "{{PRODUCT_CATEGORY}}",
      "brand": {
        "@type": "Brand",
        "name": "{{PRODUCT_BRAND}}"
      },
      "manufacturer": {
        "@id": "{{SITE_URL}}/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{PAGE_URL}}#breadcrumb",
      "itemListElement": "{{BREADCRUMB_ITEMS}}"
    }
  ]
}
