{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": "{{PAGE_URL}}#article",
      "url": "{{PAGE_URL}}",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{PAGE_URL}}"
      },
      "headline": "{{BLOG_TITLE}}",
      "description": "{{PAGE_DESCRIPTION}}",
      "image": "{{BLOG_IMAGE}}",
      "datePublished": "{{BLOG_DATE}}",
      "dateModified": "{{BLOG_DATE}}",
      "inLanguage": "{{LOCALE}}",
      "keywords": "{{BLOG_TAGS}}",
      "author": {
        "@type": "Organization",
        "@id": "{{SITE_URL}}/#organization",
        "name": "{{SITE_NAME}}",
        "url": "{{SITE_URL}}/"
      },
      "publisher": {
        "@type": "Organization",
        "@id": "{{SITE_URL}}/#organization",
        "name": "{{SITE_NAME}}",
        "url": "{{SITE_URL}}/",
        "logo": {
          "@type": "ImageObject",
          "url": "{{LOGO_URL}}"
        }
      },
      "isPartOf": {
        "@id": "{{SITE_URL}}/#website"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{PAGE_URL}}#breadcrumb",
      "itemListElement": "{{BREADCRUMB_ITEMS}}"
    }
  ]
}
